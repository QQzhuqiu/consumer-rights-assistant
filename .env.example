# =============================================================
# 凭证明白 —— AI消费权益助手  环境变量示例
# =============================================================
# 说明（重要）：
# 1. 本文件只是「配置名示例」，当前项目尚无接入代码，填写后不会产生任何效果。
# 2. 以下配置名是本项目拟定的名称，不是任何服务商的官方字段名。
# 3. 当前所有值均为空，禁止把真实密钥写进本文件（本文件会提交进仓库）。
# 4. 真实密钥请写在 .env.local（已被 .gitignore 忽略），不要提交。
# 5. 后续是否需要多个服务商配置、是否拆分文本/图片服务，
#    要等第 2 阶段的 API 小规模测试结果再决定，现在不预先设计多套配置。
#
# 安全约定：
# - 密钥仅供服务端使用，任何变量都不要加 NEXT_PUBLIC_ 前缀
#   （NEXT_PUBLIC_ 前缀的变量会被打包进浏览器端代码）。
# - 不在变量值里写入含账号、令牌的完整地址；如中转地址带身份参数，
#   应按服务商文档拆分，且只在本地 .env.local 中保存。
# - 不在截图、录屏、日志、开发日志中出现真实密钥。
# =============================================================

# 中转服务地址（示例：填写服务商给出的基址，以 http(s):// 开头的纯地址）
AI_API_BASE_URL=

# 服务密钥（仅服务端读取）
AI_API_KEY=

# 文本任务模型：必须填写服务商实际的模型 ID，不要填展示名称/别名
# 状态：待验证（本项目尚未调用，未核实模型 ID 与服务商支持情况）
AI_TEXT_MODEL=

# 图片（视觉）任务模型：必须填写服务商实际的模型 ID，不要填展示名称/别名
# 状态：待验证（是否支持图片输入、支持何种图片格式，均待实测）
# 注意：不默认所有接口/模型都具备图片能力，验证失败时该配置可为空。
AI_VISION_MODEL=

# -------------------------------------------------------------
# 待验证后再决定的配置项（现在不填写，仅留档说明）
# -------------------------------------------------------------
# - 请求超时时间（不同服务商默认值不同，需实测）
# - 单次调用最大输出长度 / 输出结构约束（JSON 模式是否支持需实测）
# - 重试上限与退避策略
# - 单轮费用上限与总预算守护（总预算约 20 美元，本阶段支出为 0）
